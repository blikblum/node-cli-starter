{
  "name": "node-cli-starter",
  "private": true,
  "version": "0.1.0",
  "main": "dist/src/index.cjs",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "build": "rimraf dist && rolldown ./src/index.ts --file dist/cli.js",
    "check-types": "tsc --noEmit",
    "dev": "tsx ./src/index.ts",
    "format": "prettier ./src --write",
    "format:check": "prettier ./src --check",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gunshi/docs": "^0.35.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "rimraf": "6.1.3",
    "rolldown": "^1.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@logtape/logtape": "^2.1.5",
    "gunshi": "^0.35.1"
  }
}
