{
  "name": "node-cli-starter",
  "description": "A node cli starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rolldown ./src/index.ts --dir dist",
    "check-types": "tsc --noEmit",
    "dev": "tsx ./src/index.ts",
    "dev:interactive": "tsx src/interactive.ts",
    "format": "oxfmt ./src --write",
    "format:check": "oxfmt ./src --check",
    "lint": "oxlint ./src",
    "lint:fix": "oxlint ./src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@gunshi/docs": "^0.37.1",
    "@inquirer/prompts": "^8.7.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@logtape/logtape": "^2.3.2",
    "gunshi": "^0.37.1"
  }
}
